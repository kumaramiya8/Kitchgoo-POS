# OrderRestro settings. Restart after editing: sudo systemctl restart nodedr-orderrestro
POSTGRES_PASSWORD=@SECRET@
HOST_PORT=1995
# Origin(s) the browser uses to open the app. Add your LAN address or domain, comma-separated.
FRONTEND_ORIGIN=http://localhost:1995
# Set true only behind real HTTPS (otherwise login breaks).
COOKIE_SECURE=false
