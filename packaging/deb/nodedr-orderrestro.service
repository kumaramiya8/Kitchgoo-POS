[Unit]
Description=OrderRestro (Docker Compose)
Documentation=https://orderrestro.nodedr.com/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name nodedr-orderrestro --env-file /etc/nodedr-orderrestro/nodedr-orderrestro.env -f /usr/lib/nodedr-orderrestro/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name nodedr-orderrestro --env-file /etc/nodedr-orderrestro/nodedr-orderrestro.env -f /usr/lib/nodedr-orderrestro/docker-compose.yml down

[Install]
WantedBy=multi-user.target
